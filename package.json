{
  "name": "mnemosyne",
  "version": "2.0.0",
  "description": "AI memory system: PostgreSQL-backed journaling MCP server with pgvector semantic search",
  "main": "dist/index.js",
  "bin": {
    "mnemosyne": "./dist/index.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "journal",
    "ai",
    "memory",
    "postgresql",
    "pgvector",
    "semantic-search"
  ],
  "author": "Jerry Snitselaar",
  "contributors": [
    "Jesse Vincent <jesse@fsck.com>"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/ui": "^2.1.8",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^17.2.3",
    "p-queue": "^9.0.0",
    "pg": "^8.11.3"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ]
}
